    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhw/opencode-tool-kagi.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.24"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
